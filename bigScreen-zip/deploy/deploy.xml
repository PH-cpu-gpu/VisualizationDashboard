<?xml version="1.0" encoding="utf-8"?>
<deploy type="" centralizedCfg="false">
	<basic describe="基本信息">
		<packType describe="包类型" options="pack:全量包;patch:补丁包">pack</packType>
		<systemType describe="系统类型">daocloud-platform</systemType>
		<group describe="应用默认分组(英文)">DaoCloud-PlatForm</group>
		<appType describe="服务标识">bigScreen-server</appType>
		<appName describe="服务别名">监控大屏服务端</appName>
		<appDescribe describe="发布包说明">监控大屏服务端</appDescribe>
		<version describe="发布包版本">20260901.1</version>
		<packInEffect describe="影响的主包（只有补丁需要配置，填写主包的版本号）"></packInEffect>
	</basic>

	<!-- 全系统全局参数配置，参数可以包括input(输入框)、select(单选框)、password(密码框)、mselect(多选框)、grid(表格)、hidden(隐藏域) editor(编辑框)-->
	<globalConfig describe="系统全局配置">
		<variables describe="集群基本参数">
			<field name="user" label="运行用户" type="input" required="true" tooltip="当前运行该项目的用户">root</field>
			<field name="workspace" label="安装目录" type="input" tooltip="请正确设置安装路径">/home/srv/gjdf/</field>
			<field name="validateStart_timeout" label="启动状态超时(秒)" visible="false" type="input" required="true">180</field>
			<field name="jvm_args" label="jvm运行参数" type="input" required="true">-Xms512m -Xmx1024m</field>
		</variables>
		<monitors>
			<mointir template="microService.json" />
		</monitors>
	</globalConfig>

	<!-- 配置系统包含的部署集群、分片、分布式框架等 -->
	<subSystems describe="子系统集合">
		<system id="bigScreen-server" mode="cluster" dependsOn="" type="jar" name="bigScreen-server集群配置">
			<repository></repository>
			<services>
				<service type="ZooKeeper" matcher="single"/>
				<service type="RabbitMQ" title="关联RabbitMQ组件">
					<matcher key="single"/>
					<cipher key="svc_rabbitmq_password" algorithm="JRES_DES"/>
				</service>
			</services>
			<databases>
				<database title="数据库" type="oracle" id="daocloud-platform" varPrefix="db" backup="false" characterSet="utf8"
						  sourceType="dbServer" database="pposjg" port="1521" host="172.24.1.200" use_sid="false" rolling="true">
					<auth user="standdbppos" password="dftest202001"/>
					<cipher key="password" algorithm="JRES_DES"/>
					<matchers>
						<matcher key="label" values="bigScreen-server"/>
					</matchers>
				</database>
			</databases>
			<scale maxSize="20" minSize="1" describe="集群规模"/>
			<scripts describe="集群脚本集">
				<!--以下的路径都是相对于./$workspace/tmp目录下的路径，运行时真正运行脚本的位置 -->
				<script name="beforeInstall" path="./${appType}/scripts/beforeInstall.sh" describe="预处理"/>
				<script name="install" path="./${appType}/scripts/install.sh" describe="部署"/>
				<script name="afterInstall" path="./${appType}/scripts/afterInstall.sh" describe="部署后置处理"/>
				<script name="start" path="./${appType}/scripts/start.sh" describe="启动"/>
				<script name="validateStart" path="./${appType}/scripts/validateStart.sh" describe="启动状态检测"/>
				<script name="stop" path="./${appType}/scripts/stop.sh" describe="停止"/>
				<script name="validateStop" path="./${appType}/scripts/validateStop.sh" describe="停止状态监测"/>
				<script name="uninstall" path="./${appType}/scripts/uninstall.sh" describe="卸载"/>
			</scripts>
			<variables describe="子系统参数配置">
				<field name="app_host" label="注册网卡"
					   tooltip="默认*表示使用第一块网卡注册。该配置项要求精确到网卡最小范围或网卡IP，如192.168.100.*或192.168.100.102"
					   type="input" required="true">*</field>
				<field name="app_server_port" label="应用端口" type="input" required="true" tooltip="根据各部门分配的端口范围设置"></field>
				<field name="rpc_protocol_name" label="rpc协议" type="input" required="true">t3</field>
				<field name="rpc_protocol_port" label="rpc服务端口" type="input" required="true" tooltip="根据各部门分配的端口范围设置"></field>
				<field name="rpc_protocol_corethreads" label="核心处理线程数" type="input" required="true">300</field>
				<field name="rpc_protocol_threads" label="最大处理线程数" type="input" required="true">500</field>
				<field name="rpc_protocol_alive" label="处理线程空闲时长（毫秒）" type="input" required="true">60000</field>
				<field name="rpc_protocol_queues" label="处理队列长度" type="input" required="true">1000</field>
				<field name="rpc_consumer_timeout" label="rpc服务消费者调用超时时长" type="input" required="true">60000</field>
				<field type="input" name="rabbit_vhost" label="rabbit虚拟机名称" tooltip="注意：需跟操作员中心服务的一致,没有使用虚拟机的，请不要填写" required="false"/>
				<field name="traceConfig" label="日志与监控" type="division" fold="true">
					<field name="log4j2_args" label="log4j2运行参数" tooltip="日志参数，不熟悉的，请谨慎修改，否则会报错" type="input" visible="false">-DAsyncLogger.RingBufferSize=16384 -DAsyncLoggerConfig.RingBufferSize=16384 -Dlog4j2.AsyncQueueFullPolicy=Discard -Dlog4j2.DiscardThreshold=ERROR</field>
					<field name="rpc_trace_log" label="全链路日志落地" type="switch" options="true:ON;false:OFF" tooltip="控制是否记录全链路tracelog日志在本地">true</field>
					<field name="rpc_trace_type" label="全链路日志采集类型" type="radio" options="protobuf:protobuf;json:json" tooltip="使用json或者protobuf格式发送全链路日志，使用protobuf格式需要日志中心打开'链路合并日志'开关">json</field>
					<field name="rpc_monitor_enable" label="RPC监控开启" type="switch" options="true:ON;false:OFF">true</field>
					<field name="hslog_topic" label="日志主题" type="input">apm</field>
					<field name="log_level" label="日志级别" type="select" options="debug:debug;info:info;warn:warn;error:error;fatal:fatal">info</field>
					<field name="log_pattern" label="日志样式" type="hidden" required="true">%d{yyyy-MM-dd HH:mm:ss.SSS} |-%-5level [%thread] %c [%L] -| %msg%n</field>
					<field name="file_pattern" label="日志文件样式" type="hidden" required="true">$${date:yyyy-MM}/app-%d{MM-dd-yyyy}-%i.log.gz</field>
					<field name="rpc_trace_task_poolsize" label="异步处理线程数" type="input" validate="Integer" tooltip="RPC全链路异步处理线程数">50</field>
					<field name="rpc_monitor_collect_interval" label="日志采集周期" type="input" validate="Integer" tooltip="RPC监控日志采集周期">5000</field>
					<field name="is_clear_log" label="是否定期清理日志" type="switchForm" default="false"  tooltip="注！打开后日志格式不再按月份来归类(之前的日志分割是按月份新增文件夹来归类),之前的历史日志要自己手工删除">
						<field name="log_day" label="删除多少天前的日志" tooltip="单位为天" type="input" validate="Integer">30</field>
						<field name="log_size" label="删除多大的日志文件" tooltip="文件大于该值，就会被删除" type="input" validate="Integer" >1</field>
						<field name="log_suffix" label="日志大小单位" tooltip="这里的单位是针对日志文件的大小，目前提供KB,MB和GB三种" type="select" options="KB:KB;MB:MB;GB:GB">GB</field>
						<field name="log_maxCount" label="最多存放多少个日志文件" tooltip="分割的文件大于该值，就不会再分割文件" type="input" validate="Integer" >20</field>
					</field>
				</field>
				<field type="division" label="接口访问控制" style="tag" fold="false">
					<field name="api_access_control_enable" label="启用接口访问控制" type="switchForm" tooltip="" options="true:ON;false:OFF" default="true">
						<field name="http_access_default_day_limit" label="默认-单日访问上限" type="input">10000</field>
						<field name="http_access_default_day_ip_limit" label="默认-单日单个IP访问上限" type="input">1000</field>
						<field name="http_access_default_ip_interval" label="每次访问间隔时间（毫秒）" type="input">1000</field>
						<field name="http_access_default_ip_interval_limit" label="单个ip短时间内访问限制次数" tooltip="超过次数后，冻结时间内不能访问" type="input">10</field>
						<field name="http_access_default_ip_frozen_time" label="冻结时间（毫秒）" type="input">30000</field>
						<field type="grid" pk="" name="httpAccessApis" label="自定义接口访问控制">
							<field type="switch" name="enable" label="是否启用" required="true" upgrade="false" options="true:ON;false:OFF">
								true
							</field>
							<field type="input" name="name" label="接口名称" tooltip="接口方法包路径.方法名，例如：com.gjzg.api.DemoService.call"
								   required="true" upgrade="false">
							</field>
							<field type="input" name="desc" label="接口说明" tooltip=""
								   required="false" upgrade="false">
							</field>
							<field type="input" name="dayAccessLimitNum" label="单日访问上限" tooltip="默认10000，-1代表无限制"
								   required="true" upgrade="false">
							</field>
							<field type="input" name="dayIpAccessLimitNum" label="单日单个IP访问上限" tooltip="默认100，-1代表无限制"
								   required="true" upgrade="false">
							</field>
							<field type="input" name="ipAccessInterval" label="每次访问间隔时间（毫秒）" tooltip="默认1000，-1代表无限制"
								   required="true" upgrade="false">
							</field>
							<field type="input" name="ipAccessIntervalLimitNum" label="单个IP间隔访问次数" tooltip="默认10，-1代表无限制，每达到此次数则冻结固定时间才能访问"
								   required="true" upgrade="false">
							</field>
							<field type="input" name="ipAccessIntervalFrozenTime" label="间隔访问冻结时间（毫秒）" tooltip="默认30s，-1代表无限制，与单个IP间隔访问次数一起使用"
								   required="true" upgrade="false">
							</field>
						</field>
					</field>
				</field>
			</variables>
			<configs>
				<!--以下config主要是用于模板变量替换，template配置的路径对应的是deploy/template目录，如果没有它也会自动查找，path配置的路径对应于workspace路径 -->
				<config path="./${appType}/config/application.properties" encoding="UTF-8" template="./application.properties"/>
				<config path="./${appType}/config/middleware.properties" encoding="UTF-8" template="./middleware.properties"/>
				<config path="./${appType}/config/sys.properties" encoding="UTF-8" template="./sys.properties"/>
				<config path="./${appType}/config/log4j2.xml" encoding="UTF-8" template="./log4j2.xml"/>
				<config path="./${appType}/scripts/beforeInstall.sh" encoding="UTF-8"/>
				<config path="./${appType}/scripts/install.sh" encoding="UTF-8"/>
				<config path="./${appType}/scripts/uninstall.sh" encoding="UTF-8"/>
				<config path="./${appType}/scripts/afterInstall.sh" encoding="UTF-8"/>
				<config path="./${appType}/scripts/start.sh" encoding="UTF-8"/>
				<config path="./${appType}/scripts/stop.sh" encoding="UTF-8"/>
				<config path="./${appType}/scripts/validateStart.sh" encoding="UTF-8"/>
				<config path="./${appType}/scripts/validateStop.sh" encoding="UTF-8"/>
			</configs>
			<node describe="节点私有配置信息"/>
		</system>
	</subSystems>
</deploy>
